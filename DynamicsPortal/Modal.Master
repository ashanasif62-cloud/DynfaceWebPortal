        <script>
            $(document).ready(function () {
                try {
                    $("table[id*='gridView'] th").each(function () {

                        var columnLength = this.innerText.length;
                        console.log("Column Name : ", this.innerText);
                        if (this.innerText === 'Employee' || this.innerText === 'Employee Name') {
                            columnLength = 130;
                        }
                        else if (columnLength === 0) {
                            columnLength = 20;
                        }
                        else if (columnLength > 0 && columnLength < 13) {
                            columnLength = (columnLength * 7) + 15;
                        }
                        else if (columnLength >= 13) {
                            columnLength = (columnLength * 7) + 10;
                        }

                        var iconExtra = 70;
                        columnLength += iconExtra;
                        $(this).css({
                            "min-width": columnLength + "px",
                        });
                        console.log("Column Width: ", columnLength);
                    });

                } catch (ex) {
                    console.error(ex);
                }
            });
        </script>
            <script>
                function showMenu(args) {
                    var panel = $(args).parent().parent().find(".dropdown-panel");

                    console.log("ARGS: ", args);
                    console.log("Found panel: ", panel);

                    panel.toggleClass("show"); // toggle once

                    console.log("Classes after toggle:", panel.attr("class"));

                }
            </script>
                <script>
                    let escBlocked = false;

                    function showOverlay() {
                        document.getElementById("overlay").style.display = "block";
                        escBlocked = true;
                        disablePage();
                    }

                    function hideOverlay() {
                        document.getElementById("overlay").style.display = "none";
                        escBlocked = false;
                        enablePage();
                    }

                    function disablePage() {
                        document.body.style.pointerEvents = 'none';
                        document.body.style.opacity = '0.6';
                    }

                    function enablePage() {
                        document.body.style.pointerEvents = '';
                        document.body.style.opacity = '';
                    }

                    // Block ESC key while processing
                    document.addEventListener("keydown", function (event) {
                        if (escBlocked && event.key === "Escape") {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                    }, true);
</script>
            <script type="text/javascript">
                var prm = Sys.WebForms.PageRequestManager.getInstance();

                prm.add_beginRequest(function () {
                    if (window.suppressOverlay) {
                        return;
                    }
                    showAJAXOverlay();  // Should now fire
                });

                prm.add_endRequest(function () {
                    hideAJAXOverlay();
                    window.suppressOverlay = false;
                });
            </script>
            <script>
                function showAJAXOverlay() {
                    if (window.suppressOverlay) return;
                    var overlay = document.getElementById("overlay");
                    if (overlay) {
                        overlay.style.display = "block";
                    }
                    escBlocked = true;
                    // Do NOT call disablePage() here, keep pointer events active
                }

                function hideAJAXOverlay() {
                    window.suppressOverlay = false;
                    var overlay = document.getElementById("overlay");
                    if (overlay) {
                        overlay.style.display = "none";
                    }
                    escBlocked = false;
                    // Do NOT call enablePage(), nothing to re-enable
                }

            </script>
        
        <script>
            //Added for user control
            // Toggle only the clicked dropdown
            $(document).on("click", ".toggle-dropdown", function (e) {
                e.stopPropagation(); // prevent document click from firing immediately
                var $panel = $(this).closest(".usercontrol-dropdown").find(".dropdown-panel");

                // Close others first
                $(".dropdown-panel").removeClass("show");

                // Toggle the clicked one
                $panel.toggleClass("show");
            });

            // Close dropdown when clicking outside
            $(document).on("click", function (e) {
                if (!$(e.target).closest(".usercontrol-dropdown").length) {
                    $(".dropdown-panel").removeClass("show");
                }
            });
        </script>
      <div class="modal fade" id="globalDeleteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="border-bottom: 1px solid #e0e0e0; padding: 14px 16px;">
                <h4 class="modal-title" style="font-size: 15px; font-weight: 600; color: #185FA5;">
                    Confirm Delete
                </h4>
            </div>
            <div class="modal-body" style="padding: 20px 16px;">
                <p id="globalDeleteModalMessage" style="margin: 0; color: #444; font-size: 14px;">
                    This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #e0e0e0; padding: 12px 16px;">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnGlobalConfirmDelete"
                    style="background:#185FA5; border-color:#185FA5;">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    var GlobalDeleteConfirm = (function () {
        var _callback = null;
        document.getElementById('btnGlobalConfirmDelete').addEventListener('click', function () {
            $('#globalDeleteModal').modal('hide');
            if (typeof _callback === 'function') { _callback(); _callback = null; }
        });
        $('#globalDeleteModal').on('hidden.bs.modal', function () { _callback = null; });
        return {
            show: function (options) {
                options = options || {};
                var msg = document.getElementById('globalDeleteModalMessage');
                if (msg) msg.textContent = options.message || 'This action cannot be undone.';
                _callback = options.onConfirm || null;
                $('#globalDeleteModal').modal('show');
            }
        };
    })();
</script>
          <script>
              /* ── Global row highlight on checkbox select ── */
              document.addEventListener('change', function (e) {
                  var t = e.target;

                  /* Single row checkbox */
                  if (t && t.id && t.id.indexOf('chk_SelectSingle') !== -1) {
                      var row = t.closest('tr');
                      if (row) {
                          row.classList.toggle('row-selected', t.checked);
                      }
                  }

                  /* Select-All checkbox */
                  if (t && t.id === 'chk_SelectAll') {
                      var boxes = document.querySelectorAll('input[id*="chk_SelectSingle"]');
                      for (var i = 0; i < boxes.length; i++) {
                          var row = boxes[i].closest('tr');
                          if (row) {
                              row.classList.toggle('row-selected', t.checked);
                          }
                      }
                  }
              });

              /* ── Re-apply highlights after UpdatePanel postbacks ── */
              if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                  Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                      /* Clear all highlights after grid rebind */
                      document.querySelectorAll('tr.row-selected').forEach(function (r) {
                          r.classList.remove('row-selected');
                      });
                      /* Uncheck select-all */
                      var selectAll = document.getElementById('chk_SelectAll');
                      if (selectAll) selectAll.checked = false;
                  });
              }
          </script>
        <%-- ── Global Popup Modal ── --%>
<div class="modal fade" id="globalPopupModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document" style="width:860px; max-width:95vw;">
        <div class="modal-content" style="border-radius:8px; overflow:hidden;">
            <div class="modal-header" style="padding:10px 16px; border-bottom:1px solid #e0e0e0;">
                <h4 class="modal-title" id="globalPopupModalTitle" 
                    style="font-size:15px; font-weight:600; color:#185FA5; margin:0;">
                </h4>
                <button type="button" class="close" data-dismiss="modal" 
                    style="margin-top:-2px;">&times;</button>
            </div>
            <div class="modal-body" style="padding:0;">
                <iframe id="globalPopupModalFrame" src="" 
                    style="width:100%; height:70vh; border:none; display:block;"></iframe>
            </div>
        </div>
    </div>
</div>

<script>
    var GlobalPopup = (function () {
        var frame = document.getElementById('globalPopupModalFrame');
        var title = document.getElementById('globalPopupModalTitle');

        /* Reset iframe on close to stop any running scripts inside */
        $('#globalPopupModal').on('hidden.bs.modal', function () {
            if (frame) frame.src = '';
        });

        return {
            show: function (options) {
                options = options || {};
                if (title) title.textContent = options.title || '';
                if (frame) frame.src = options.url || '';
                $('#globalPopupModal').modal('show');
            },
            hide: function () {
                $('#globalPopupModal').modal('hide');
            }
        };
    })();

    function closeParentModal() {
        // If using Bootstrap Modal from a parent page
        if (window.parent && window.parent.$) {
            window.parent.$('.modal').modal('hide');
        }

        // If using a custom framework or window.close for popups
        if (window.parent && window.parent.closeModal) {
            window.parent.closeModal();
        }
    }
</script>
