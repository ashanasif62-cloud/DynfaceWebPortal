     /* Global Delete Modal */
#globalDeleteModal .modal-header {
    background: #fff;
    border-bottom: 1px solid #e0e0e0;
    border-radius: 6px 6px 0 0;
    padding: 8px 16px; /* reduced top & bottom */
}

#globalDeleteModal .modal-header .modal-title {
    font-size: 15px;
    font-weight: 600;
    color: #185FA5;
    margin: 0; /* removes extra vertical spacing */
}

#globalDeleteModal .modal-content {
    border-radius: 6px;
    border: none;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}

#globalDeleteModal .modal-footer {
    padding: 8px 16px; /* also reduce footer height */
}

#globalDeleteModal .modal-footer .btn-primary {
    background: #185FA5;
    border-color: #185FA5;
}

#globalDeleteModal .modal-footer .btn-default {
    background: #fff;
    border-color: #ced4da;
    color: #333;
}
/* ── Row selection highlight ── */
table.table tbody tr.row-selected {
    background-color: #E8F1FB !important;
    outline: 1.5px solid #185FA5;
    outline-offset: -1px;
}

table.table tbody tr.row-selected td {
    color: #0d3f6e;
}

/* smooth transition */
table.table tbody tr {
    transition: background-color 0.15s ease;
    cursor: pointer;
}

    </style>

