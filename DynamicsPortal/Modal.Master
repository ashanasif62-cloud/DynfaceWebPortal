            function showNotificationMessage(message, alertType, notifyParent) {
                var typeMap = { success: 'success', error: 'error', danger: 'error', warning: 'warning', info: 'info' };
                window.showModalToast(message, typeMap[(alertType || 'info').toLowerCase()] || 'info', 5000);

                if (notifyParent === 'True' || notifyParent === true) {
                    if (window.parent && window.parent.location) {
                        setTimeout(function () { window.parent.location.reload(); }, 2000);
                    }
                }
            }

            document.addEventListener("click", function () {
                // Tell the parent window to collapse its side menu
                if (window.parent && window.parent !== window) {
                    var parentMenu = window.parent.document.querySelector(".main-menu");
                    if (parentMenu) {
                        parentMenu.classList.remove("expanded");
                        window.parent.sessionStorage.setItem("navMenuExpanded", "false");
                    }
                }
            });
        </script>
