        <script>
            let escBlocked = false;

            function showOverlay() {
                document.getElementById("overlay").style.display = "block";
                escBlocked = true;
                disablePage();
            }

            function hideOverlay() {
                document.getElementById("overlay").style.display = "none";
                escBlocked = false;
                enablePage();
            }

            function disablePage() {
                document.body.style.pointerEvents = 'none';
                document.body.style.opacity = '0.6';
            }

            function enablePage() {
                document.body.style.pointerEvents = '';
                document.body.style.opacity = '';
            }

            // Block ESC key while processing
            document.addEventListener("keydown", function (event) {
                if (escBlocked && event.key === "Escape") {
                    event.preventDefault();
                    event.stopPropagation();
                }
            }, true);
        </script>
           <script>
               // Save selected page number before unload
               document.addEventListener("click", function (e) {
                   if (e.target.classList.contains("pageNumber")) {
                       const page = e.target.textContent.trim();
                       sessionStorage.setItem("pageNum", page);
                   }
               });

               // Restore selected page after load
               window.addEventListener("load", function () {
                   const savedPage = sessionStorage.getItem("pageNum");
                   if (!savedPage) return;

                   // Retry logic to wait until pagination elements exist
                   const tryRestore = () => {
                       const pages = document.querySelectorAll(".pageNumber");
                       if (pages.length > 0) {
                           const targetPage = Array.from(pages).find(el => el.textContent.trim() === savedPage);
                           if (targetPage && !targetPage.classList.contains("active")) {
                               targetPage.click(); // simulate click on the saved page
                           }
                       } else {
                           // Try again after 200ms
                           setTimeout(tryRestore, 200);
                       }
                   };

                   tryRestore(); // initial try
               });
</script>
        <script>
            function bindPageNumPersistence() {
                // Save selected page number
                document.querySelectorAll(".pageNumber").forEach(el => {
                    el.addEventListener("click", function () {
                        const page = this.textContent.trim();
                        sessionStorage.setItem("pageNum", page);
                    });
                });

                // Restore selected page number
                const savedPage = sessionStorage.getItem("pageNum");
                if (!savedPage) return;

                const tryRestore = () => {
                    const pages = document.querySelectorAll(".pageNumber");
                    if (pages.length > 0) {
                        const targetPage = Array.from(pages).find(el => el.textContent.trim() === savedPage);
                        if (targetPage && !targetPage.classList.contains("active")) {
                            targetPage.click();
                        }
                    } else {
                        setTimeout(tryRestore, 200);
                    }
                };
                tryRestore();
            }

            // Run on first page load
            document.addEventListener("DOMContentLoaded", bindPageNumPersistence);

            // Run after every UpdatePanel partial postback
            if (typeof Sys !== "undefined" && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                    bindPageNumPersistence();
                });
            }
        </script>


    </form>
    <script>
        function showAJAXOverlay() {
            if (window.suppressOverlay) return;
            var overlay = document.getElementById("overlay");
            if (overlay) {
                overlay.style.display = "block";
            }
            escBlocked = true;
        }

        function hideAJAXOverlay() {
            window.suppressOverlay = false;
            var overlay = document.getElementById("overlay");
            if (overlay) {
                overlay.style.display = "none";
            }
            escBlocked = false;
        }

    </script>
    <script type="text/javascript">
        function applyUpButtonsStyle() {
            var el = document.getElementById("ActionPanel_updButtons");
            if (el) {
                el.style.display = "contents";
            }
        }

        // Run on page load
        window.onload = function () {
            applyUpButtonsStyle();
        };

        // Run after every partial postback
        if (typeof (Sys) !== "undefined" && Sys.WebForms && Sys.WebForms.PageRequestManager) {
            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                applyUpButtonsStyle();
            });
        }
    </script>
    <script>
        function showMenu(args) {
            //debugger;
            $(args).parent().parent().find(".dropdown-panel").toggleClass("show");
        }
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const menu = document.querySelector(".main-menu");
            if (!menu) return;

            const allUls = menu.querySelectorAll("ul");
            const topUl = allUls[0]; // first UL (hamburger toggle)

            // ── 1. RESTORE expanded state from sessionStorage ──────────────
            if (sessionStorage.getItem("navMenuExpanded") === "true") {
                menu.classList.add("expanded");
            }

            // ── 2. HAMBURGER always toggles expand/collapse ───────────────
            topUl.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopPropagation();
                menu.classList.toggle("expanded");
                sessionStorage.setItem("navMenuExpanded",
                    menu.classList.contains("expanded") ? "true" : "false");
            });

            // ── 3. ANY click inside the nav while COLLAPSED → expand it ──
            //      This covers module icons, Home, etc. that live outside topUl.
            //      When already expanded, only the hamburger (above) collapses it.
            menu.addEventListener("click", function (e) {
                if (!menu.classList.contains("expanded")) {
                    // Nav is collapsed — expand it on any click

                    // If it's a link, prevent navigation and stop propagation
                    var anchor = e.target.closest("a");
                    if (anchor) {
                        e.preventDefault();
                        e.stopPropagation();
                    }

                    menu.classList.add("expanded");
                    sessionStorage.setItem("navMenuExpanded", "true");
                    return; // Sidebar expanded, don't process further
                }

                // Nav is expanded — set state to closed for the next page load
                var anchor = e.target.closest("a");
                if (anchor) {
                    var href = anchor.getAttribute("href") || "";
                    // Real nav links = not "#", not collapse toggles (start with #), not JS
                    var isRealNav = href.length > 0 && href !== "#" &&
                                   !href.startsWith("#") &&
                                   href.indexOf("javascript") === -1;
                    if (isRealNav) {
                        sessionStorage.setItem("navMenuExpanded", "false");
                    }
                }
            }, true);

            // ── 4. Collapse ONLY when clicking completely outside the menu ─
            let mousedownInsideMenu = false;
            document.addEventListener("mousedown", function (e) {
                mousedownInsideMenu = menu.contains(e.target);
            });
            document.addEventListener("touchstart", function (e) {
                mousedownInsideMenu = menu.contains(e.target);
            }, { passive: true });

            document.addEventListener("click", function (e) {
                if (mousedownInsideMenu) {
                    return; // Ignore clicks/drags that originated inside the menu
                }
                if (!menu.contains(e.target)) {
                    menu.classList.remove("expanded");
                    sessionStorage.setItem("navMenuExpanded", "false");
                }
            });

            // ── 5. Highlight the ACTIVE menu item ─────────────────────────
            var currentPath = window.location.pathname.toLowerCase();

            // Helper: normalize a path for comparison
            function normalizePath(p) {
                try {
                    // Handle absolute URLs (openPopupPanel links have full paths)
                    if (p.indexOf("://") !== -1) {
                        p = new URL(p).pathname;
                    }
                } catch (ex) { }
                var normalized = p.toLowerCase().replace(/\\/g, "/").replace(/\/+$/, "");
                if (normalized === "" || normalized === "/") {
                    return "/default.aspx";
                }
                return normalized;
            }

            var normalizedCurrent = normalizePath(currentPath);

            // Find all <a> tags inside the nav (skip the top hamburger)
            var navLinks = menu.querySelectorAll("li a");
            var bestMatch = null;
            var bestScore = 0; // High scores indicate better match quality
            var bestMatchLength = 0;

            navLinks.forEach(function (a) {
                var href = (a.getAttribute("href") || "").trim();
                if (!href || href === "#" || href.indexOf("javascript") !== -1) return;

                var normalizedHref = normalizePath(href);
                if (!normalizedHref) return;

                // Check if the link resides inside Recent or Favourites shortcuts
                var isShortcut = a.closest("#userMenuItems_recent") || a.closest("#userMenuItems_fav");

                var score = 0;
                var isExact = (normalizedCurrent === normalizedHref);
                var isPrefix = (!isExact && normalizedCurrent.indexOf(normalizedHref) === 0);

                if (isExact) {
                    score = 3; // Highest priority for exact matches
                } else if (isPrefix) {
                    score = 2; // Secondary priority for prefix matches
                } else {
                    return; // No match at all
                }

                // Apply a small penalty to shortcut links (Recent/Favourites) to prioritize main menu items
                if (isShortcut) {
                    score -= 0.5;
                }

                // Determine if this match is superior to the current best match
                if (score > bestScore) {
                    bestMatch = a;
                    bestScore = score;
                    bestMatchLength = normalizedHref.length;
                } else if (score === bestScore) {
                    // Tie-breaker for prefix matches: prefer the longer, more specific prefix
                    if (isPrefix && normalizedHref.length > bestMatchLength) {
                        bestMatch = a;
                        bestMatchLength = normalizedHref.length;
                    }
                }
            });

            if (bestMatch) {
                // Add .active to the immediate <li>
                var li = bestMatch.closest("li");
                if (li) li.classList.add("active");

                // Also expand the parent collapse panel (for nested items)
                var parentCollapse = bestMatch.closest("ul.collapse");
                if (parentCollapse) {
                    parentCollapse.classList.add("show");
                    var parentToggle = menu.querySelector(
                        "a[href='#" + parentCollapse.id + "']"
                    );
                    if (parentToggle) {
                        parentToggle.setAttribute("aria-expanded", "true");
                    }
                }

               
            }
        });
    </script>
    <script>
        /* ── Global row highlight on checkbox select ── */
        document.addEventListener('change', function (e) {
            var t = e.target;

            /* Single row checkbox */
            if (t && t.id && t.id.indexOf('chk_SelectSingle') !== -1) {
                var row = t.closest('tr');
                if (row) {
                    if (t.checked) {
                        row.classList.add('row-selected');
                    } else {
                        row.classList.remove('row-selected');
                    }
                }
            }

            /* Select-All checkbox */
            if (t && t.id === 'chk_SelectAll') {
                var allowedStatuses = ['draft', 'not submitted'];  /* ← same list */
                var boxes = document.querySelectorAll('input[id*="chk_SelectSingle"]');
                for (var i = 0; i < boxes.length; i++) {
                    var row = boxes[i].closest('tr');
                    if (!row) continue;

                    /* Check the row's status before selecting */
                    var statusCell = row.querySelector('.lp-badge');
                    var statusText = statusCell
                        ? (statusCell.textContent || '').trim().toLowerCase()
                        : '';

                    var allowed = allowedStatuses.indexOf(statusText) !== -1;

                    if (t.checked && allowed) {
                        boxes[i].checked = true;
                        row.classList.add('row-selected');
                    } else {
                        boxes[i].checked = false;
                        row.classList.remove('row-selected');
                    }
                }
            }
        });

        /* ── Also allow clicking anywhere on the row to toggle checkbox ── */
        /* ── Also allow clicking anywhere on the row to toggle checkbox ── */
        document.addEventListener('click', function (e) {
            var row = e.target.closest('table.table tbody tr');
            if (!row) return;

            /* Ignore clicks directly on buttons, links, inputs */
            var tag = e.target.tagName.toLowerCase();
            if (tag === 'input' || tag === 'a' || tag === 'button' ||
                tag === 'select' || tag === 'textarea' || tag === 'label') return;

            var chk = row.querySelector('input[id*="chk_SelectSingle"]');
            if (!chk) return;

            /* Only allow selection if WorkflowStatus is Draft */
            var allowedStatuses = ['draft', 'not submitted'];  /* ← add more values here if needed */
            var statusCell = row.querySelector('.lp-badge');
            var statusText = statusCell
                ? (statusCell.textContent || '').trim().toLowerCase()
                : '';

            if (allowedStatuses.indexOf(statusText) === -1) return; /* Block selection */

            chk.checked = !chk.checked;
            chk.dispatchEvent(new Event('change', { bubbles: true }));
        });

        /* ── Re-apply highlights after UpdatePanel postbacks ── */
        if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                /* Clear all highlights after grid rebind */
                document.querySelectorAll('tr.row-selected').forEach(function (r) {
                    r.classList.remove('row-selected');
                });
                /* Uncheck select-all */
                var selectAll = document.getElementById('chk_SelectAll');
                if (selectAll) selectAll.checked = false;
            });
        }
    </script>
     <%-- ── Global Popup Modal ── --%>
<div class="modal fade" id="globalPopupModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document" style="width:860px; max-width:95vw;">
        <div class="modal-content" style="border-radius:8px; overflow:hidden;">
            <div class="modal-header" style="padding:10px 16px; border-bottom:1px solid #e0e0e0;">
                <h4 class="modal-title" id="globalPopupModalTitle" 
                    style="font-size:15px; font-weight:600; color:#185FA5; margin:0;">
                </h4>
                <button type="button" class="close" data-dismiss="modal" 
                    style="margin-top:-2px;">&times;</button>
            </div>
            <div class="modal-body" style="padding:0;">
                <iframe id="globalPopupModalFrame" src="" 
                    style="width:100%; height:70vh; border:none; display:block;"></iframe>
            </div>
        </div>
    </div>
</div>

<script>
    var GlobalPopup = (function () {
        var frame = document.getElementById('globalPopupModalFrame');
        var title = document.getElementById('globalPopupModalTitle');

        /* Reset iframe on close to stop any running scripts inside */
        $('#globalPopupModal').on('hidden.bs.modal', function () {
            if (frame) frame.src = '';
        });

        return {
            show: function (options) {
                options = options || {};
                if (title) title.textContent = options.title || '';
                if (frame) frame.src = options.url || '';
                $('#globalPopupModal').modal('show');
            },
            hide: function () {
                $('#globalPopupModal').modal('hide');
            }
        };
    })();

    function closeParentModal() {
        // If using Bootstrap Modal from a parent page
        if (window.parent && window.parent.$) {
            window.parent.$('.modal').modal('hide');
        }

        // If using a custom framework or window.close for popups
        if (window.parent && window.parent.closeModal) {
            window.parent.closeModal();
        }
    }
</script>
