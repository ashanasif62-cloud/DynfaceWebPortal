    <script>
        document.addEventListener('DOMContentLoaded', function () {

            var menu = document.querySelector('.main-menu');
            if (!menu) return;

            menu.addEventListener('click', function (e) {

                var anchor = e.target.closest('a');
                if (!anchor) return;

                var href = anchor.getAttribute('href') || '';

                /* ── Skip non-navigation clicks ── */
                var isCollapse = href.startsWith('#');           // expand/collapse toggle
                var isJavascript = href.indexOf('javascript') !== -1;
                var isPopup = (anchor.getAttribute('onclick') || '').indexOf('openPopupPanel') !== -1;
                var isEmpty = !href || href === '#';

                if (isCollapse || isJavascript || isPopup || isEmpty) return;

                /* ── It's a real page navigation — show the overlay ── */
                showAJAXOverlay();
            });

        });

        (function () {
            var prm = Sys.WebForms.PageRequestManager.getInstance();

            prm.add_beginRequest(function () {
                showAJAXOverlay();
            });

            prm.add_endRequest(function () {
                hideAJAXOverlay();
                // Reset pagination guard flags
                $('table.sortable').each(function () {
                    $(this).removeData('sortable-initialized');
                });
                initPaginationAndSorting();
                applyUpButtonsStyle();
                bindPageNumPersistence();
            });
        })();
    </script>
</body>
</html>
