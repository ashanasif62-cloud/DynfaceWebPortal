        <script>
            var GlobalDeleteConfirm = (function () {
                var _callback = null;
                document.getElementById('btnGlobalConfirmDelete').addEventListener('click', function () {
                    $('#globalDeleteModal').modal('hide');
                    if (typeof _callback === 'function') { _callback(); _callback = null; }
                });
                $('#globalDeleteModal').on('hidden.bs.modal', function () { _callback = null; });
                return {
                    show: function (options) {
                        options = options || {};
                        var msg = document.getElementById('globalDeleteModalMessage');
                        if (msg) msg.textContent = options.message || 'This action cannot be undone.';
                        _callback = options.onConfirm || null;
                        $('#globalDeleteModal').modal('show');
                    }
                };
            })();
        </script>
        <script type="text/javascript">
            try {
                Chart.plugins.register({
                    afterDraw: function (chart) {
                        var noData = false;
                        //debugger;
                        if (chart.data.datasets.length === 0)
                            noData = true;
                        if (chart.data.datasets.length > 0)
                            if (chart.data.datasets[0].data.length === 0)
                                noData = true;

                        if (noData) {
                            // No data is present
                            var chartCTX = chart.chart.ctx;
                            var width = chart.chart.width;
                            var height = chart.chart.height;
                            chart.clear();

                            chartCTX.save();
                            chartCTX.textAlign = 'center';
                            chartCTX.textBaseline = 'middle';
                            chartCTX.font = "12px 'Segoe UI'";//"Segoe UI", tahoma, 
                            chartCTX.fillStyle = "black";
                            chartCTX.fillText('No data to display', width / 2, height / 2);
                            chartCTX.restore();
                        }
                    }
                });
            }
            catch (ex) {
                var errorMsg = ex;
                //alert(errorMsg);
            }

            $(document).ready(function () {
                try {
                    $("table[id*='gridView'] th").each(function () {
                        var $th = $(this);
                        var $allThs = $th.closest('thead').find('th');
                        var indexInRow = $allThs.index($th);
                        var isFirst = (indexInRow === 0);
                        var isLast = (indexInRow === $allThs.length - 1);

                        // CSS already controls these — skip them entirely
                        if (isFirst || isLast) return;

                        // Strip trailing newlines/icons from innerText before measuring
                        var rawText = (this.innerText || '').replace(/[\uE000-\uF8FF\n\r\t]/g, '').trim();

                        var columnLength = rawText.length;

                        if (rawText === 'Employee' || rawText === 'Employee Name') {
                            columnLength = 130;
                        }
                        else if (columnLength === 0) {
                            columnLength = 20;
                        }
                        else if (columnLength > 0 && columnLength < 13) {
                            columnLength = (columnLength * 7) + 15;
                        }
                        else if (columnLength >= 13) {
                            columnLength = (columnLength * 7) + 10;
                        }

                        var iconExtra = 40;
                        columnLength += iconExtra;

                        // Cap at 220px — prevents long headers from over-stretching
                        if (columnLength > 220) columnLength = 220;

                        $th.css({ "min-width": columnLength + "px" });
                    });

                } catch (ex) {
                    console.error(ex);
                }
            });




            $(document).ready(function () {
                var $searchPanel = $("#searchPanel");
                $searchPanel.show();

                var actionPanelContainer = $("#actionPanelContainer");
                if (actionPanelContainer.length > 0) {
                    $(".page-contents").css({
                        "height": "calc(100vh - 48px)",
                        "overflow": "hidden",        // ← CHANGED: hidden, not scroll/visible
                        "width": "100%",
                        "max-width": "100%",
                        "box-sizing": "border-box"
                    });
                    $(".page-placeholder").css({
                        "height": "calc(100vh - 128px)",
                        "overflow-x": "auto",        // ← use auto not scroll (avoids ghost scrollbar)
                        "overflow-y": "auto",
                        "width": "100%",
                        "max-width": "100%",
                        "box-sizing": "border-box"
                    });
                } else {
                    $(".page-contents").css({
                        "height": "calc(100vh - 48px)",
                        "overflow": "hidden",        // ← CHANGED: was "visible", kills child scroll
                        "width": "100%",
                        "max-width": "100%",
                        "box-sizing": "border-box"
                    });
                    $(".page-placeholder").css({
                        "height": "calc(100vh - 48px)",
                        "overflow-x": "auto",
                        "overflow-y": "auto",
                        "width": "100%",
                        "max-width": "100%",
                        "box-sizing": "border-box"
                    });
                }

            });

            $(function () {
                $("#mydiv").draggable();
            });
        </script>
                <script>
                    function applyAutocomplete() {
                        $('.filterable-dropdown').each(function () {
                            console.log("The Function is Running");
                            var $dropdown = $(this);

                            // Avoid adding input twice
                            if ($dropdown.next('.autocomplete-input').length === 0) {
                                var options = [];

                                $dropdown.find('option').each(function () {
                                    if ($(this).val()) {
                                        options.push({
                                            label: $(this).text(),
                                            value: $(this).val()
                                        });
                                    }
                                });

                                var placeholderText = '';
                                var dropdownId = $dropdown.attr('id')?.toLowerCase();

                                switch (dropdownId) {
                                    case "ddluserid":
                                        placeholderText = '-- Select User --';
                                        break;
                                    case "ddlroleid":
                                        placeholderText = '-- Select Role --';
                                        break;
                                }

                                var $input = $('<input type="text" class="autocomplete-input form-control" />')
                                    .attr('placeholder', placeholderText)
                                    .val($dropdown.val()) // show only ItemId
                                    .insertAfter($dropdown)
                                    .autocomplete({
                                        source: options,
                                        minLength: 0,
                                        select: function (event, ui) {
                                            $dropdown.val(ui.item.value);
                                            $dropdown.trigger('change'); // ✅ ASP.NET postback trigger
                                        }
                                    })
                                    .on("focus", function () {
                                        $(this).autocomplete("search", ""); // Show all options on focus
                                    });

                                $dropdown.hide();
                            }
                        });
                    }

                    // Initialize on document ready and after UpdatePanel postbacks
                    $(document).ready(function () {
                        applyAutocomplete();

                        if (Sys && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(applyAutocomplete);
                        }
                    });
                </script>

<%--        <script>
    $(document).ready(function () {

        function loadEvents(year, month) {
            var fromDate = new Date(year, month, 1);
            var toDate = new Date(year, month + 1, 0);

            $.ajax({
                type: "POST",
                url: "/default.aspx/GetRegisterDetails",
                data: JSON.stringify({
                    fromDate: fromDate.toISOString().split('T')[0],
                    toDate: toDate.toISOString().split('T')[0]
                }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var rawEvents = JSON.parse(response.d);

                    var events = rawEvents.map(function (evt) {
                        var d = new Date(evt.Date);
                        return {
                            Date: new Date(d.getFullYear(), d.getMonth(), d.getDate()),
                            Title: evt.Title,
                            Link: evt.Link || "#",
                            BgColor: evt.BgColor || null,
                            Color: evt.Color || null,
                            CssClass: evt.CssClass || null
                        };
                    });

                    var element = document.getElementById('caleandar');
                    element.innerHTML = ""; // clear previous calendar

                    var settings = {
                        NavShow: true,
                        DateTimeShow: true,
                        onMonthChange: function (year, month) {
                            loadEvents(year, month);
                        }
                    };

                    caleandar(element, events, settings);
                },
                error: function (xhr, status, error) {
                    console.error("Error loading calendar data:", error);
                }
            });
        }

        var today = new Date();
        loadEvents(today.getFullYear(), today.getMonth());
    });
</script>--%>




